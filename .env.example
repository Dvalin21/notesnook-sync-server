# Notesnook Sync Server — environment template for git
#
# Copy this to .env and fill in every CHANGEME value:
#
#   cp .env.example .env
#
# Do NOT commit .env. Generation of strong secrets:
#
#   openssl rand -base64 48
#   openssl rand -base64 12
#   openssl rand -base64 22
#

# ── instance identity ────────────────────────────────────────────
INSTANCE_NAME=CHANGEME-my-notesnook

# ── API security ──────────────────────────────────────────────────
# Auth token signing/validation secret. Generate one:
#   openssl rand -base64 48
NOTESNOOK_API_SECRET=CHANGEME

# ── feature toggles ───────────────────────────────────────────────
# Block new account registrations. Values: true / false
DISABLE_SIGNUPS=true

# ── SMTP (email) — optional ──────────────────────────────────────
# Required only for email-based 2FA and password reset.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=alerts@example.com
SMTP_PASSWORD=CHANGEME
SMTP_FROM_NAME=Notesnook

# ── Twilio (SMS 2FA) — optional ──────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SERVICE_SID=

# ── public URLs ──────────────────────────────────────────────────
# Used by Notesnook clients. Always use https with your real domain.
NOTESNOOK_APP_PUBLIC_URL=https://sync.example.com
AUTH_SERVER_PUBLIC_URL=https://auth.example.com
MONOGRAPH_PUBLIC_URL=https://notes.example.com
ATTACHMENTS_SERVER_PUBLIC_URL=https://attach.example.com

# ── cors / proxy awareness ───────────────────────────────────────
NOTESNOOK_CORS_ORIGINS=
KNOWN_PROXIES=

# ── caddy routing ────────────────────────────────────────────────
# Base domain for Host-header routing in Caddyfile.
SERVER_DOMAIN=example.com

# ── MinIO S3 ─────────────────────────────────────────────────────
# MinIO admin credentials. Change these from the well-known defaults.
# Generate fresh ones:
#   MINIO_ROOT_USER:   openssl rand -base64 12 (min 3 chars)
#   MINIO_ROOT_PASSWORD: openssl rand -base64 22 (min 8 chars)
MINIO_ROOT_USER=CHANGEME
MINIO_ROOT_PASSWORD=CHANGEME
SELF_HOSTED=1
