# Notesnook Sync Server — environment
#
# NEVER commit real secrets here. If this file is tracked without git-crypt or
# similar, the values below are sacrificial placeholders.
#
# HOW TO USE THIS STACK
#
# 1. Each backend service publishes its own port (see table below). Your
#    TLS-terminating reverse proxy routes to the correct port.
#
#    https://sync.example.com    → notesnook-server:5264
#    https://auth.example.com    → identity-server:8264
#    https://sse.example.com     → sse-server:7264
#    https://notes.example.com   → monograph-server:6264
#    https://attach.example.com  → garage/minio S3 API
#
# 2. If using the Garage S3 overlay (docker-compose.garage.yml), Garage port
#    3900 is only reachable inside the Docker network.
#

# ── instance identity ────────────────────────────────────────────
INSTANCE_NAME=CHANGEME-my-notesnook

# ── API security ──────────────────────────────────────────────────
# Auth token signing/validation secret. Generate one:
#   openssl rand -base64 48
NOTESNOOK_API_SECRET=CHANGEME-replace-with-openssl-rand-base64-48

# ── feature toggles ───────────────────────────────────────────────
# Disable new account registrations. Values: true / false
# Default is false (registration open). After creating your account,
# set to true and restart.
DISABLE_SIGNUPS=false

# ── SMTP (email) — optional ──────────────────────────────────────
# Required only for email-based 2FA and password reset.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=alerts@example.com
SMTP_PASSWORD=CHANGEME-smtp-password
SMTP_FROM_NAME=Notesnook

# ── Twilio (SMS 2FA) — optional ──────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SERVICE_SID=

# ── public URLs ──────────────────────────────────────────────────
# Used by Notesnook clients. Always use https with your real domain.
NOTESNOOK_APP_PUBLIC_URL=https://sync.example.com
AUTH_SERVER_PUBLIC_URL=https://auth.example.com
MONOGRAPH_PUBLIC_URL=https://notes.example.com
ATTACHMENTS_SERVER_PUBLIC_URL=https://attach.example.com

# ── cors / proxy awareness ───────────────────────────────────────
# Comma-separated list of allowed origins for CORS. Default * allows all.
NOTESNOOK_CORS_ORIGINS=*
KNOWN_PROXIES=

# ── Garage S3 (garage-migration branch) ──────────────────────────
# Garage replaces MinIO as the S3 object storage backend.
# Generate credentials:
#   GARAGE_ACCESS_KEY_ID:    openssl rand -base64 12
#   GARAGE_ACCESS_KEY_SECRET: openssl rand -base64 24
#   GARAGE_RPC_SECRET:       openssl rand -base64 32
GARAGE_ACCESS_KEY_ID=CHANGEME-garage-access-key
GARAGE_ACCESS_KEY_SECRET=CHANGEME-garage-secret-key
GARAGE_RPC_SECRET=CHANGEME-garage-rpc-secret

# ── MinIO (fallback, not used on garage-migration branch) ────────
MINIO_ROOT_USER=CHANGEME-minio-user
MINIO_ROOT_PASSWORD=CHANGEME-minio-password

SELF_HOSTED=1
