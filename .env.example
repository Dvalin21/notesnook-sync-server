# Notesnook Sync Server — safe template for git

# Copy to .env and edit every CHANGEME.
#   cp .env.example .env
#
# Secret generation helpers:
#   openssl rand -base64 48   # NOTESNOOK_API_SECRET
#   openssl rand -base64 12   # MINIO_ROOT_USER
#   openssl rand -base64 22   # MINIO_ROOT_PASSWORD

# ── identity ─────────────────────────────────────────────────────
INSTANCE_NAME=CHANGEME-my-notesnook

# ── API security ──────────────────────────────────────────────────
NOTESNOOK_API_SECRET=CHANGEME

# ── feature toggles ───────────────────────────────────────────────
DISABLE_SIGNUPS=true

# ── SMTP (optional — for email 2FA and password reset) ───────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=alerts@example.com
SMTP_PASSWORD=CHANGEME
SMTP_FROM_NAME=Notesnook

# ── Twilio (optional — for SMS 2FA) ──────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SERVICE_SID=

# ── public URLs ──────────────────────────────────────────────────
# These must use HTTPS and match the subdomains you configure in your
# TLS reverse proxy / DNS. Base domain comes from SERVER_DOMAIN below.
#
# Client field mapping:
#   NOTESNOOK_APP_PUBLIC_URL  -> Android app Sync URL
#   AUTH_SERVER_PUBLIC_URL    -> Android app Auth URL
#   ATTACHMENTS_SERVER_PUBLIC_URL -> Android app Attachments URL
#   MONOGRAPH_PUBLIC_URL      -> Web browser Notes client URL
#
# Caddy host-header routing in this stack:
#   sync.example.com   -> notesnook-server:5264
#   auth.example.com   -> identity-server:8264
#   sse.example.com    -> sse-server:7264
#   notes.example.com  -> monograph-server:3000
#   example.com        -> monograph-server:3000
#   attach.example.com -> notesnook-s3:9000
#   minio.example.com  -> notesnook-s3:9090
#   cors.example.com   -> cors-proxy:3000
#
# All of the above are served on ONE external port: 8080.
NOTESNOOK_APP_PUBLIC_URL=https://sync.example.com
AUTH_SERVER_PUBLIC_URL=https://auth.example.com
MONOGRAPH_PUBLIC_URL=https://notes.example.com
ATTACHMENTS_SERVER_PUBLIC_URL=https://attach.example.com

# ── proxy awareness ──────────────────────────────────────────────
NOTESNOOK_CORS_ORIGINS=
KNOWN_PROXIES=

# ── Caddy routing ────────────────────────────────────────────────
SERVER_DOMAIN=example.com

# ── MinIO S3 ─────────────────────────────────────────────────────
# MinIO admin credentials. Change these from the well-known defaults.
# Generate fresh ones:
#   MINIO_ROOT_USER:      openssl rand -base64 12 (min 3 chars)
#   MINIO_ROOT_PASSWORD:  openssl rand -base64 22 (min 8 chars)
MINIO_ROOT_USER=CHANGEME
MINIO_ROOT_PASSWORD=CHANGEME
SELF_HOSTED=1
