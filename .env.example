# Notesnook Sync Server — environment
#
# NEVER commit real secrets here. If this file is tracked without git-crypt or
# similar, the values below are sacrificial placeholders.
#
# HOW TO USE THIS STACK
#
# 1. Set SERVER_DOMAIN near the top of this file. It is the only domain you
#    type; every URL below is derived from it.
# 2. Point your TLS terminator / reverse proxy at this host on port 8080.
# 3. The same 8080 port serves every service by Host header
#    (10 subdomains + the apex). For SERVER_DOMAIN=example.com:
#
#    https://sync.example.com    → notesnook API:5264
#    https://auth.example.com    → identity API:8264
#    https://sse.example.com     → SSE hub:7264
#    https://notes.example.com   → Monograph web client:3000
#    https://example.com         → Monograph web client:3000  (apex — OPTIONAL,
#                                    see README "The apex is optional in practice".
#                                    Nothing in .env points at it, and a missing
#                                    proxy host for it is not a fault.)
#    https://attach.example.com  → MinIO S3 API:9000
#    https://minio.example.com   → MinIO console:9090
#    https://cors.example.com    → CORS proxy:3000
#    https://inbox.example.com   → Inbox API:5181          (optional)
#    https://themes.example.com  → Themes server:9000      (optional)
#    https://app.example.com     → web client:80
#
# If your TLS proxy already handles example.com you do NOT need to expose
# 6264/7264/8264/5264/9000/9090 host ports for clients.
#

# ── MongoDB credentials ─────────────────────────────────────────
# Required. mongod runs with --auth, and Mongo disables the unauthenticated
# localhost exception as soon as the first user exists, so every client --
# the two .NET services, the healthcheck and backup.sh -- must authenticate.
# Use ALPHANUMERIC characters only: these values sit inside a mongodb:// URI,
# and a base64 password contains + / = which are URI-reserved and produce an
# "Authentication failed" that looks like a wrong password.
# The user needs the root role on admin (it owns both app databases).
MONGO_USER=CHANGEME-mongo-user
MONGO_PASS=CHANGEME-alphanumeric-only-32-chars

# ── instance identity ────────────────────────────────────────────
INSTANCE_NAME=CHANGEME-my-notesnook

# ── API security ──────────────────────────────────────────────────
# Auth token signing/validation secret. Generate one:
#   openssl rand -base64 48
NOTESNOOK_API_SECRET=CHANGEME-replace-with-openssl-rand-base64-48

# ── feature toggles ───────────────────────────────────────────────
# Disable new account registrations. Values: true / false
DISABLE_SIGNUPS=false

# ── SMTP (email) — optional ──────────────────────────────────────
# Required for email-based 2FA and for password reset. Without it, account
# recovery does not work at all — see README "Troubleshooting".
# Leave blank to disable email features.
#
# These are THIRD-PARTY addresses, not yours. They are deliberately NOT
# ${SERVER_DOMAIN}-derived: your mail provider is someone else's domain, and
# find/replace across this file must not rewrite them.
SMTP_HOST=smtp.your-mail-provider.com
SMTP_PORT=587
SMTP_USERNAME=alerts@your-mail-provider.com
SMTP_PASSWORD=CHANGEME-smtp-password
SMTP_FROM_NAME=Notesnook
NOTESNOOK_SENDER_EMAIL=noreply@your-mail-provider.com

# ── Twilio (SMS 2FA) — optional ──────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SERVICE_SID=

# ── your domain ─────────────────────────────────────────────────
# THE ONLY DOMAIN YOU SET. Every URL below is derived from it, and the
# Caddyfile derives its Host-header matchers from it the same way, so routing
# and configuration cannot drift apart.
#
# Two things to know:
#   1. This line MUST stay above every line that references it. Docker Compose
#      interpolates .env in file order, and an undefined reference expands to
#      an empty string -- which produces a broken URL, not an error.
#   2. Set it to the apex domain only, no scheme, no trailing dot:
#        SERVER_DOMAIN=example.com          correct
#        SERVER_DOMAIN=https://example.com   WRONG -- becomes sync.https://example.com
SERVER_DOMAIN=example.com

# ── public URLs — derived from SERVER_DOMAIN, do not edit ───────
# Used by Notesnook clients. These are the URLs a browser or phone will see, so
# they are https even though everything behind :8080 is plain HTTP: your TLS
# terminator converts it. Caddy routes each of these to its backend by Host.
#
# WARNING: NOTESNOOK_APP_PUBLIC_URL is the SYNC server, despite the name. It is
# what the web client calls for its API. The web client's OWN origin is
# NOTESNOOK_APP_HOST at the bottom of this block. Do not point
# NOTESNOOK_APP_PUBLIC_URL at app.<domain> -- the web image substitutes it for
# the sync host, and the client then calls itself instead of the sync API.
NOTESNOOK_APP_PUBLIC_URL=https://sync.${SERVER_DOMAIN}
AUTH_SERVER_PUBLIC_URL=https://auth.${SERVER_DOMAIN}
MONOGRAPH_PUBLIC_URL=https://notes.${SERVER_DOMAIN}
ATTACHMENTS_SERVER_PUBLIC_URL=https://attach.${SERVER_DOMAIN}
SSE_SERVER_PUBLIC_URL=https://sse.${SERVER_DOMAIN}
# Web client origin (recovery/verified links). NOT the sync URL.
NOTESNOOK_APP_HOST=https://app.${SERVER_DOMAIN}

# ── optional services (extras) ────────────────────────────────────
# Only required if you deploy inbox-api and/or themes-server.
# Leave blank to disable.
#
# INBOX_API_PUBLIC_URL — public URL where the Inbox API is reachable.
#   The Notesnook app uses this to send encrypted inbox notifications.
#   Must be a URL on your domain, routed through Caddy to the inbox-api
#   container (port 5181 internally).
#   Set to empty string "" to disable inbox functionality.
#
# THEMES_SERVER_PUBLIC_URL — public URL where the Themes Server is reachable.
#   The Notesnook app queries this to fetch available theme metadata.
#   Must be an https:// URL on your domain, routed through Caddy to
#   the themes-server container (port 9000 internally).
#   Set to empty string "" to disable theme fetching.
#
# THEMES_REPO_URL — Git repository URL the themes-server clones on startup.
#   The themes-server pulls this repo to serve theme metadata from.
#   Default: the official streetwriters/notesnook-themes repo.
#   Change this only if you host your own theme repo and want the
#   server to serve custom themes instead of the upstream set.
#   Must be a valid git clone URL (https or ssh).
#
# NOTESNOOK_API_SERVER_URL — (inbox-api only) internal URL the Inbox API
#   uses to call back to the Notesnook sync server. The inbox-api service
#   fetches the user's public encryption key from here and posts encrypted
#   inbox items back here. This is set inside docker-compose.yml to the
#   internal Docker network address (http://notesnook-server:5264) so
#   you typically do NOT need to set it in .env. Only override it in .env
#   if you know why you need to — for a standard self-hosted deploy the
#   compose file value is correct.
INBOX_API_PUBLIC_URL=https://inbox.${SERVER_DOMAIN}
THEMES_SERVER_PUBLIC_URL=https://themes.${SERVER_DOMAIN}
THEMES_REPO_URL=https://github.com/streetwriters/notesnook-themes.git

# ── cors / proxy awareness ───────────────────────────────────────
# Comma-separated list of allowed origins for CORS proxy. Use * to allow all.
# NOTE: the proxy sends a single Access-Control-Allow-Origin value, so a
# comma-separated list of several origins only ever honours the first.
# Blank this and cors-proxy falls back to "*" — allow every origin — on a
# service that fetches URLs from the internet on your behalf. Leave it set.
NOTESNOOK_CORS_ORIGINS=https://app.${SERVER_DOMAIN}

# Hostnames the CORS proxy is allowed to fetch. It is an internet-facing fetch
# proxy, so it refuses anything not listed (400). Suffix match, so
# "wikimedia.org" also covers thumb.wikimedia.org. Keep youtube.com and
# youtube-nocookie.com or video embeds break. Add a host here when an image
# fails to render. It also only forwards image/* responses (403 otherwise).
NOTESNOOK_CORS_DOMAINS=imgur.com,wikimedia.org,githubusercontent.com,github.com,github.io,youtube.com,youtube-nocookie.com,redd.it,redditmedia.com

# Per-client rate limit for the CORS proxy.
CORS_RATE_LIMIT=120
CORS_RATE_WINDOW_MS=60000

# Address of the reverse proxy in front of this stack.
#
# This is NOT optional, and the value below is the working default. Every
# .NET service calls UseForwardedHeaders(), and ASP.NET Core only honours
# X-Forwarded-Proto / X-Forwarded-For from a proxy listed here.
#
# WHY THE DEFAULT MATTERS: with this blank the forwarded headers are
# silently STRIPPED and nothing errors loudly. Routes still return 200 and
# healthchecks still pass, but the OIDC discovery document starts
# advertising plain http:
#
#   jwks_uri: http://auth.example.com/.../jwks     <- broken
#   jwks_uri: https://auth.example.com/.../jwks    <- correct
#
# and password login then fails at token introspection with HTTP 500. This
# was reproduced on a wiped-volume install with KNOWN_PROXIES empty; it is
# the single most confusing failure mode in this stack, because the stack
# boots 11/11 healthy and only sign-in is dead.
#
# WHY 172.19.0.12 AND NOT THE BRIDGE GATEWAY: this stack terminates TLS in
# the caddy service, so the immediate upstream that connects to the .NET
# services is Caddy itself. Caddy's address is pinned to 172.19.0.12 in
# docker-compose.yml, and this value MUST match that pin.
#
# Do NOT put the docker bridge gateway here. Measured on this stack, the
# gateway is 172.19.0.1 and using it yields:
#   jwks_uri: http://auth.example.com/.../jwks  <- still broken
# because the gateway is not the hop the services see.
#
# If you change the pin in docker-compose.yml, change it here too.
# To confirm the value actually works, the discovery document must be https:
#   curl -s https://auth.<your-domain>/.well-known/openid-configuration \
#     | grep -o '"jwks_uri":"[^"]*"'
KNOWN_PROXIES=172.19.0.12

# ── caddy routing ────────────────────────────────────────────────
# SERVER_DOMAIN is set near the top of this file, above the URLs that derive
# from it. The Caddyfile reads it as {$DOMAIN} and builds its Host matchers
# from it, so there is nothing to set here.

# ── MinIO bucket-scoped service account ───────────────────────────
# Run `bash scripts/create-minio-app-user.sh` to generate these. They are a
# service account limited to the attachments bucket -- NOT the MinIO root
# credentials above. Never point these at MINIO_ROOT_*.
S3_ACCESS_KEY_ID=CHANGEME-run-scripts-create-minio-app-user
S3_ACCESS_KEY=CHANGEME-run-scripts-create-minio-app-user

# ── MinIO S3 (root -- used only to administer the object store) ─────
# MinIO admin credentials. Change these from the well-known defaults.
# Generate fresh ones:
#   MINIO_ROOT_USER:   openssl rand -base64 12 (min 3 chars)
#   MINIO_ROOT_PASSWORD: openssl rand -base64 22 (min 8 chars)
MINIO_ROOT_USER=CHANGEME-minio-user
MINIO_ROOT_PASSWORD=CHANGEME-minio-password
SELF_HOSTED=1
