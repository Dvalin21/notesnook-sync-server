# Placeholder values for CI ONLY. Never used by a real deployment.
#
# docker compose config -q is a PARSER check: it proves the compose file is
# syntactically valid and that every ${...} interpolation resolves. It does not
# start anything, so these values are never used to reach a service.
#
# It must exist because .env is gitignored, and compose's ${VAR:?} guards abort
# when a required variable is missing -- which is what made this step fail on
# every push before this file was added. Keep every key that docker-compose.yml
# interpolates, or the guard fires and the check stops meaning anything.
SELF_HOSTED=1
SERVER_DOMAIN=ci.example.com
INSTANCE_NAME=ci
DISABLE_SIGNUPS=true
NOTESNOOK_API_SECRET=ci-placeholder-not-a-real-secret
MONGO_USER=ciuser
MONGO_PASS=ciplaceholderpassword
MINIO_ROOT_USER=ciuser
MINIO_ROOT_PASSWORD=ciplaceholderpassword
S3_ACCESS_KEY_ID=ci-placeholder-run-scripts-create-minio-app-user
S3_ACCESS_KEY=ci-placeholder-run-scripts-create-minio-app-user
# Referenced by the validate service's own required list; also interpolated by
# docker-compose.yml for cors-proxy and the web build args.
NOTESNOOK_APP_PUBLIC_URL=https://sync.ci.example.com
AUTH_SERVER_PUBLIC_URL=https://auth.ci.example.com
MONOGRAPH_PUBLIC_URL=https://notes.ci.example.com
ATTACHMENTS_SERVER_PUBLIC_URL=https://attach.ci.example.com
SSE_SERVER_PUBLIC_URL=https://sse.ci.example.com
NOTESNOOK_APP_HOST=https://app.ci.example.com
