# Notesnook Sync Stack — Internal Reverse Proxy
# Set SERVER_DOMAIN in .env to your domain (e.g. "example.com").
# Default "localhost" works for local testing with /etc/hosts entries.
# Routes by Host header to the correct backend service.
# TLS is handled by your external proxy — Caddy does plain HTTP internally.

{
    # Disable automatic HTTPS — we are behind a TLS-terminating proxy
    auto_https off
    admin off
}

:80 {
    # ponytail: access log for per-request timing (blame split app-vs-server)
    log {
        output stdout
        format json
    }
    # Caddy health
    handle /health {
        respond "Healthy"
    }

    # Route by Host header
    @sync host sync.{$DOMAIN}
    @auth host auth.{$DOMAIN}
    @sse host sse.{$DOMAIN}
    @monograph host notes.{$DOMAIN} {$DOMAIN}
    @attach host attach.{$DOMAIN}
    @minio host minio.{$DOMAIN}
    @cors host cors.{$DOMAIN}
    @inbox host inbox.{$DOMAIN}
    @themes host themes.{$DOMAIN}
    @app host app.{$DOMAIN}

    handle @sync {
        reverse_proxy notesnook-server:5264 {
            header_up X-Forwarded-Host {http.request.host}
        }
    }
    handle @auth {
        reverse_proxy identity-server:8264 {
            header_up X-Forwarded-Host {http.request.host}
        }
    }
    handle @sse {
        reverse_proxy sse-server:7264 {
            header_up X-Forwarded-Host {http.request.host}
        }
    }
    handle @monograph {
        reverse_proxy monograph-server:3000 {
            header_up X-Forwarded-Host {http.request.host}
        }
    }
    handle @attach {
        # ponytail: browser CORS is answered here, not MinIO (its bucket
        # CORS API is unimplemented in this build). Web UI origin only.
        @attach_preflight method OPTIONS
        handle @attach_preflight {
            header Access-Control-Allow-Origin https://app.example.com
            header Access-Control-Allow-Methods "PUT, GET, HEAD, DELETE"
            header Access-Control-Allow-Headers *
            header Access-Control-Max-Age 86400
            respond "" 204
        }
        reverse_proxy notesnook-s3:9000 {
            header_up X-Forwarded-Host {http.request.host}
            header_down Access-Control-Allow-Origin https://app.example.com
            header_down Access-Control-Expose-Headers ETag
        }
    }
    handle @minio {
        reverse_proxy notesnook-s3:9090 {
            header_up X-Forwarded-Host {http.request.host}
        }
    }
    handle @cors {
        reverse_proxy cors-proxy:3000 {
            header_up X-Forwarded-Host {http.request.host}
        }
    }
    handle @inbox {
        reverse_proxy inbox-api:5181 {
            header_up X-Forwarded-Host {http.request.host}
        }
    }
    handle @themes {
        reverse_proxy themes-server:9000 {
            header_up X-Forwarded-Host {http.request.host}
        }
    }
    handle @app {
        reverse_proxy web:80 {
            header_up X-Forwarded-Host {http.request.host}
        }
    }

    # Path-based fallbacks (catch unmatched Host headers)
    @s3-path path /attachments/* /minio/*
    handle @s3-path {
        reverse_proxy notesnook-s3:9000 {
            header_up X-Forwarded-Host {http.request.host}
        }
    }

    # Default: serve monograph (web client)
    reverse_proxy monograph-server:3000 {
        header_up X-Forwarded-Host {http.request.host}
    }
}
