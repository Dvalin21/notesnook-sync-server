# Notesnook Sync Stack — Internal Reverse Proxy
# Set SERVER_DOMAIN in .env to your domain (e.g. "example.com").
# Default "localhost" works for local testing with /etc/hosts entries.
# Routes by Host header to the correct backend service.
# TLS is handled by your external proxy — Caddy does plain HTTP internally.

{
    # Disable automatic HTTPS — we are behind a TLS-terminating proxy
    auto_https off
    admin off
    servers {
        trusted_proxies static private_ranges
    }
}

:80 {
    # ponytail: access log for per-request timing (blame split app-vs-server).
    #
    # The three S3 presigning parameters are redacted. Presigned URLs carry
    # ?X-Amz-Credential=<access key> and ?X-Amz-Signature=<sig>, and Caddy
    # logged the full URI -- so the MinIO access key was written to the access
    # log on every attachment transfer. That is precisely the input
    # CVE-2026-40344 needs: an access key ALONE permits unsigned object writes,
    # with no secret key and a fabricated signature.
    #
    # access_token is redacted for a different reason. Notesnook.API accepts the
    # bearer token from the query string as well as the header
    # (Startup.cs, TokenRetrieval.FromQueryString) -- that is required, because
    # the SignalR sync hub connects over WebSockets and a browser WebSocket
    # cannot set an Authorization header. So the token legitimately appears in
    # the URL of /hubs/sync/v2 requests. A reference token in the access log is
    # a session credential in a plaintext log file that is kept for the log
    # rotation window.
    #
    # Every other query parameter is kept, so uploadId/partNumber debugging
    # still works. The query is still sent upstream; only the log is filtered.
    log {
        output stdout
        format filter {
            wrap json
            fields {
                request>uri query {
                    replace X-Amz-Credential REDACTED
                    replace X-Amz-Signature REDACTED
                    replace X-Amz-Security-Token REDACTED
                    replace access_token REDACTED
                }
            }
        }
    }
    # Caddy health
    handle /health {
        respond "Healthy"
    }

    # ── CVE-2026-40344 / CVE-2026-41145 guard, defined ONCE ──────────────────
    # Declared here, beside the other matchers, because it has to be applied to
    # EVERY route that reaches MinIO -- not just @attach. It used to be defined
    # inside `handle @attach` only, which left the /attachments/* path fallback
    # (below) forwarding exactly the header the advisories tell you to block:
    #
    #   attach.<domain>/attachments/obj  X-Amz-Content-Sha256: STREAMING-... -> 403, empty body (Caddy)
    #   <any other host>/attachments/obj  same request                      -> MinIO's own error, i.e.
    #                                                                            it REACHED the vulnerable build
    #
    # Both advisories (GHSA-9c4q-hq6p-c237, GHSA-hv4r-mvr4-25vw) word the
    # mitigation unconditionally: "Reject any request containing
    # X-Amz-Content-Sha256: STREAMING-UNSIGNED-PAYLOAD-TRAILER at the reverse
    # proxy or WAF layer." Patched versions: None. Clients that need trailers
    # use the signed variant (STREAMING-AWS4-HMAC-SHA256-PAYLOAD-TRAILER), which
    # this does not match.
    @unsigned_trailer header X-Amz-Content-Sha256 STREAMING-UNSIGNED-PAYLOAD-TRAILER

    # Route by Host header
    @sync host sync.{$DOMAIN}
    @auth host auth.{$DOMAIN}
    @sse host sse.{$DOMAIN}
    @monograph host notes.{$DOMAIN} {$DOMAIN}
    @attach host attach.{$DOMAIN}
    @minio host minio.{$DOMAIN}
    @cors host cors.{$DOMAIN}
    @inbox host inbox.{$DOMAIN}
    @themes host themes.{$DOMAIN}
    @app host app.{$DOMAIN}

    # The guard itself, ahead of every Host route.
    #
    # It used to live inside `handle @attach` and `handle @s3-path`. That does
    # not work, and the reason is Caddy semantics rather than intent: `handle`
    # blocks are mutually exclusive and the FIRST one that matches wins. Every
    # host matcher below is a bare `host` test, so it matches any path. That
    # made `handle @sync` (and @auth, @sse, ...) claim /attachments/* before
    # `handle @s3-path` was ever considered, and the fallback guard was dead
    # code for every request carrying a real Host header. Measured, with
    # X-Amz-Content-Sha256: STREAMING-UNSIGNED-PAYLOAD-TRAILER on
    # /attachments/x, before this change:
    #
    #   attach.<domain> -> 403   (guard ran)
    #   sync.<domain>   -> 404   (shadowed by handle @sync, guard never ran)
    #
    # A request with an unrecognised Host did reach @s3-path, which is the only
    # reason this went unnoticed.
    #
    # Placed here it cannot be shadowed by any route added later, which is
    # the property the comment above this matcher was claiming and did not
    # have. It is also cheaper: the request dies at the proxy and never
    # reaches a backend.
    #
    # `handle /health` above still comes first. It is a bare path match, so it
    # would swallow /health with this header present -- harmless, since it
    # answers a literal string and proxies nothing -- but it means this is the
    # first handle that guards a ROUTE, not literally the first handle.
    handle @unsigned_trailer {
        respond 403
    }

    handle @sync {
        # Bound the upload body. Without this an authenticated client can POST
        # an arbitrarily large body to /s3 and the server will try to buffer it.
        request_body {
            max_size 100MB
        }
        reverse_proxy notesnook-server:5264 {
            header_up X-Forwarded-Host {http.request.host}
        }
    }
    handle @auth {
        reverse_proxy identity-server:8264 {
            header_up X-Forwarded-Host {http.request.host}
        }
    }
    handle @sse {
        reverse_proxy sse-server:7264 {
            header_up X-Forwarded-Host {http.request.host}
        }
    }
    handle @monograph {
        reverse_proxy monograph-server:3000 {
            header_up X-Forwarded-Host {http.request.host}
        }
    }
    handle @attach {
        # ── CVE-2026-40344 / CVE-2026-41145 mitigation ──────────────────────
        # MinIO's STREAMING-UNSIGNED-PAYLOAD-TRAILER path verifies the
        # signature only if an Authorization header is present, while
        # isPutActionAllowed trusts credentials from the X-Amz-Credential
        # QUERY parameter. An attacker holding just an access key can PUT
        # arbitrary objects with no secret key and a fabricated signature.
        # Confirmed present in the running build's source:
        #   cmd/object-handlers.go: newUnsignedV4ChunkedReader(r, true,
        #     r.Header.Get(xhttp.Authorization) != "")
        #   PutObjectExtractHandler's switch has no case for
        #     authTypeStreamingUnsignedTrailer -> falls through unverified.
        #
        # minio/minio is ARCHIVED (2026-04-25) and the open-source line has
        # NO patched release -- "Patched versions: None". The fix ships only
        # in commercial MinIO AIStor. Both GHSA-9c4q-hq6p-c237 and
        # GHSA-hv4r-mvr4-25vw name this exact load-balancer block as the
        # mitigation, so that is what this does.
        #
        # The actual `respond 403` for @unsigned_trailer is the first handle in
        # this site block, not a line in here. See the comment on it. A guard
        # placed inside a route cannot be relied on to cover the OTHER routes:
        # these host matchers are bare `host` tests and win on any path, so an
        # in-route guard on @s3-path was unreachable behind handle @sync.

        # Same cap as the sync route: presigned multipart parts PUT straight
        # here, so an unbounded body is reachable without touching /s3.
        request_body {
            max_size 100MB
        }
        # ponytail: browser CORS is answered here, not MinIO (its bucket
        # CORS API is unimplemented in this build). Web UI origin only.
        @attach_preflight method OPTIONS
        handle @attach_preflight {
            header Access-Control-Allow-Origin {$NOTESNOOK_APP_HOST}
            header Access-Control-Allow-Methods "PUT, GET, HEAD, DELETE"
            header Access-Control-Allow-Headers *
            header Access-Control-Max-Age 86400
            respond "" 204
        }
        reverse_proxy notesnook-s3:9000 {
            header_up X-Forwarded-Host {http.request.host}
            header_down Access-Control-Allow-Origin {$NOTESNOOK_APP_HOST}
            header_down Access-Control-Expose-Headers ETag
        }
    }
    handle @minio {
        # The console upstream exists only when MINIO_CONSOLE=on. Answer 404
        # rather than proxying to a port nothing is listening on, which would
        # surface as a bare 502 and read like a broken stack.
        # CEL needs the value as a quoted STRING. {$MINIO_CONSOLE} is substituted
        # before CEL parses, so `!= "on"` became `!= off` -- an undeclared
        # identifier -- and Caddy refused to start at all (verified: "compiling
        # CEL program: undeclared reference to 'off'"). Quote it.
        @console_off expression "{$MINIO_CONSOLE}" != "on"
        respond @console_off 404
        reverse_proxy notesnook-s3:9090 {
            header_up X-Forwarded-Host {http.request.host}
        }
    }
    handle @cors {
        reverse_proxy cors-proxy:3000 {
            header_up X-Forwarded-Host {http.request.host}
        }
    }
    handle @inbox {
        reverse_proxy inbox-api:5181 {
            header_up X-Forwarded-Host {http.request.host}
        }
    }
    handle @themes {
        reverse_proxy themes-server:9000 {
            header_up X-Forwarded-Host {http.request.host}
        }
    }
    handle @app {
        reverse_proxy web:80 {
            header_up X-Forwarded-Host {http.request.host}
        }
    }

    # Path-based fallbacks (catch unmatched Host headers)
    @s3-path path /attachments/* /minio/*
    handle @s3-path {
        # The CVE guard is NOT here. It is the first handle in this site block,
        # which is the only position that cannot be shadowed by the host
        # matchers above. A copy here did nothing: every real Host header was
        # already claimed by handle @sync before this block was considered.

        # Same body cap as the two routes above: multipart parts PUT here too.
        request_body {
            max_size 100MB
        }
        reverse_proxy notesnook-s3:9000 {
            header_up X-Forwarded-Host {http.request.host}
        }
    }

    # Default: serve monograph (web client)
    reverse_proxy monograph-server:3000 {
        header_up X-Forwarded-Host {http.request.host}
    }
}
