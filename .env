# ═══════════════════════════════════════════════════════════════
# Notesnook Sync Server — Environment Configuration (MinIO)
# ═══════════════════════════════════════════════════════════════
# Replace every value that says "CHANGEME" with your own.
# DO NOT use these defaults in production.
# ═══════════════════════════════════════════════════════════════

# ── Instance identity ──────────────────────────────────────────
# Human-readable name shown in Notesnook clients.
# Required: yes
INSTANCE_NAME=CHANGEME-my-notesnook-instance

# ── API security ───────────────────────────────────────────────
# Auth token signing/validation secret. Generate one:
#   openssl rand -base64 48
# Required: yes
NOTESNOOK_API_SECRET=CHANGEME-openssl-rand-base64-48

# Block new account registrations. true = locked down (admin only).
# Required: yes | values: true / false
DISABLE_SIGNUPS=false

# ── SMTP (email) — optional ────────────────────────────────────
# If unset, email-based 2FA and password reset are disabled.
# The stack will warn but still start without SMTP.
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
# Sender display name in outgoing emails (optional, no default)
# SMTP_FROM_NAME=My Notesnook

# ── Twilio (SMS 2FA) — optional ────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SERVICE_SID=

# ── Public URLs ────────────────────────────────────────────────
# These tell Notesnook clients where to find each service.
#
# TWO SETUPS — PICK ONE:
#
# A) DIRECT PORTS (simpler, for localhost testing):
#    NOTESNOOK_APP_PUBLIC_URL=http://localhost:5264   (sync)
#    AUTH_SERVER_PUBLIC_URL=http://localhost:8264      (auth)
#    MONOGRAPH_PUBLIC_URL=http://localhost:6264        (web client)
#    ATTACHMENTS_SERVER_PUBLIC_URL=http://localhost:9000 (S3)
#
# B) CADDY + TLS PROXY (production — routes by subdomain):
#    Need a domain and TLS proxy pointing to port 8080.
#    Caddy routes by Host header (see README routing table).
#    NOTESNOOK_APP_PUBLIC_URL=https://sync.your.domain
#    AUTH_SERVER_PUBLIC_URL=https://auth.your.domain
#    MONOGRAPH_PUBLIC_URL=https://notes.your.domain
#    ATTACHMENTS_SERVER_PUBLIC_URL=https://attach.your.domain
#
# Default below = direct ports (option A), which work
# immediately for "docker compose up" on localhost.
#
# Required: yes
# ponytail: direct ports for local testing; README explains Caddy
NOTESNOOK_APP_PUBLIC_URL=http://localhost:5264
AUTH_SERVER_PUBLIC_URL=http://localhost:8264
MONOGRAPH_PUBLIC_URL=http://localhost:6264
# MinIO port 9000 is exposed to host for direct access (see compose).
# Remove `ports: - "9000:9000"` from notesnook-s3 in docker-compose.yml
# if you route attachments through Caddy instead.
ATTACHMENTS_SERVER_PUBLIC_URL=http://localhost:9000

# Comma-separated CORS origins the sync server accepts.
# Empty = allow all (fine behind your proxy).
NOTESNOOK_CORS_ORIGINS=

# Comma-separated known reverse proxy IPs (optional).
KNOWN_PROXIES=

# ── Caddy routing ──────────────────────────────────────────────
# Hostname used in Caddyfile for virtual-host routing.
# "localhost" = test with /etc/hosts entries.
SERVER_DOMAIN=localhost

# ── MinIO S3 ───────────────────────────────────────────────────
# MinIO admin credentials. Change these from the well-known defaults.
# Generate fresh ones:
#   MINIO_ROOT_USER:   openssl rand -base64 12 (min 3 chars)
#   MINIO_ROOT_PASSWORD: openssl rand -base64 22 (min 8 chars)
# If left empty, MinIO defaults to minioadmin / minioadmin.
MINIO_ROOT_USER=CHANGEME-openssl-rand-base64-12
MINIO_ROOT_PASSWORD=CHANGEME-openssl-rand-base64-22
