# ── instance identity ────────────────────────────────────────────
INSTANCE_NAME=self-hosted-notesnook-instance

# ── API security ──────────────────────────────────────────────────
NOTESNOOK_API_SECRET=

# ── feature toggles ───────────────────────────────────────────────
DISABLE_SIGNUPS=false

# ── SMTP (email) — optional ──────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=alerts@example.com
SMTP_PASSWORD=
SMTP_FROM_NAME=Notesnook

# ── Twilio (SMS 2FA) — optional ──────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SERVICE_SID=

# ── public URLs ──────────────────────────────────────────────────
NOTESNOOK_APP_PUBLIC_URL=https://sync.example.com
AUTH_SERVER_PUBLIC_URL=https://auth.example.com
MONOGRAPH_PUBLIC_URL=https://notes.example.com
ATTACHMENTS_SERVER_PUBLIC_URL=https://attach.example.com

# ── cors / proxy awareness ───────────────────────────────────────
NOTESNOOK_CORS_ORIGINS=*
KNOWN_PROXIES=

# ── Garage S3 credentials ────────────────────────────────────────
GARAGE_ACCESS_KEY_ID=
GARAGE_ACCESS_KEY_SECRET=
GARAGE_RPC_SECRET=

# ── MinIO (fallback) ─────────────────────────────────────────────
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

SELF_HOSTED=1
